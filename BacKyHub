        end,
        setStage = function(index, level)
            currentStage = math.clamp(tonumber(index) or currentStage, 1, #STAGES)
            refreshStage()
            local stage = STAGES[currentStage]
            local current = tonumber(level) or (isHost and targetState.cloneLevel) or getLocalLevel()
            if isHost then
                currentLevelLabel.Text = targetState.ready
                    and string.format("LOWEST CLONE LV.%d", current)
                    or "WAITING CLONE LV"
            else
                currentLevelLabel.Text = string.format("CURRENT LV.%d", current)

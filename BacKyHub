local function syncStageFromLowestCloneLevel(lowestLevel, lowestName)
    if not isHost or not lowestLevel or lowestLevel <= 0 then return false end

    local resolvedName = lowestName or targetState.cloneName or "clone"
    local desiredStage = getStageForCloneLevel(lowestLevel)
    local targetChanged = not targetState.ready
        or targetState.stageIndex ~= desiredStage
        or targetState.cloneLevel ~= lowestLevel
        or targetState.cloneName ~= resolvedName

    targetState.ready = true
    targetState.stageIndex = desiredStage
    targetState.cloneLevel = lowestLevel
    targetState.cloneName = resolvedName
    targetState.lastLiveAt = os.clock()

    -- The target card follows the lowest clone immediately in both lobby and
    -- dungeon. Only `activeStageIndex` remains fixed until the current run
    -- ends, so the server map itself is never switched mid-dungeon.
    local displayedChanged = currentStage ~= desiredStage
    if displayedChanged then
        currentStage = desiredStage
        UI.setStage(currentStage, lowestLevel)
        saveStage()
    end
    if targetChanged or displayedChanged then
        targetState.revision = targetState.revision + 1
        UI.addLog(string.format("Clone target applied: %s LV.%d -> %s (%s)", resolvedName, lowestLevel, STAGES[desiredStage].map, STAGES[desiredStage].diff), "success")
    end
    return targetChanged or displayedChanged, desiredStage
end

local function getHostQueueLobby(containerName)
    local games = workspace:FindFirstChild("games")
    local container = games and games:FindFirstChild(containerName)
    if not container then return nil end

    -- Exact findLobby implementation from queue.lua/lobbyInfo.lua: search only
    -- direct room children. Never descend into mapName.private (the whitelist).
    local localActualKey = string.lower(tostring(localPlayer.Name))
    local localRealKey = string.lower(tostring((playerRealNames and playerRealNames[localPlayer]) or localPlayer.Name))
    for _, gameLobby in ipairs(container:GetChildren()) do
        for _, member in ipairs(gameLobby:GetChildren()) do
            local nodeKey = string.lower(tostring(member.Name))
            if nodeKey == localActualKey or nodeKey == localRealKey then return gameLobby end
        end
    end
    return nil
end

local function getLowestHostLobbyCloneLevel()
    local gameLobby = getHostQueueLobby("inLobby")
    if not gameLobby then return nil, nil end

    local lowestLevel, lowestName = nil, nil

    -- populateLobby in the supplied source prefers this server-authored JSON
    -- attribute. It already carries username (`n`) and exact level (`l`).
    local encodedRoster = gameLobby:GetAttribute("Roster")
    if type(encodedRoster) == "string" then
        local ok, roster = pcall(HttpService.JSONDecode, HttpService, encodedRoster)
        if ok and type(roster) == "table" then
            for _, entry in ipairs(roster) do
                local name = type(entry) == "table" and tostring(entry.n or "") or ""
                local level = type(entry) == "table" and tonumber(entry.l) or nil
                if name ~= "" and string.lower(name) ~= string.lower(localPlayer.Name)
                    and level and level > 0 and (not lowestLevel or level < lowestLevel) then
                    lowestLevel, lowestName = level, name
                end
            end
            if lowestLevel then return lowestLevel, lowestName end
        end
    end

    -- Compatibility fallback mirrors lobbyInfo.lua's direct StringValue path.
    for _, member in ipairs(gameLobby:GetChildren()) do
        if member:IsA("StringValue") and member.Name ~= "mapName" then
            local plr = Players:FindFirstChild(member.Name)
            if plr and plr ~= localPlayer then
                local level = getPlayerLevel(plr)
                if level > 0 and (not lowestLevel or level < lowestLevel) then
                    lowestLevel, lowestName = level, tostring(plr.Name)
                end
            end
        end
    end
    return lowestLevel, lowestName
end

-- Inside a Level server, Players:GetPlayers() is the participant authority.
-- `ready` is intentionally not required: the live game may omit it after the
-- loading phase even though the clone and its teammate UI are fully present.
local function snapshotHostDungeonRoster()
    local snapshot = {}
    local connected, resolved, initialized = 0, 0, 0
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= localPlayer then
            connected = connected + 1
            local char = plr.Character
            if char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChildOfClass("Humanoid")) then
                initialized = initialized + 1
            end
            local realName = (playerRealNames and playerRealNames[plr]) or tostring(plr.Name)
            local actualKey = string.lower(tostring(plr.Name))
            local realKey = string.lower(realName)
            local level = getPlayerLevel(plr)
            local hasResolvedLevel = level > 0
            local previous = cloneRoster.entries[realKey] or cloneRoster.entries[actualKey]
            if level <= 0 and previous then level = tonumber(previous.level) or 0 end
            if level > 0 then
                if hasResolvedLevel then resolved = resolved + 1 end
                snapshot[string.lower(realName)] = {
                    name = realName,
                    level = level,
                    missedMatches = 0,
                }
            end
        end
    end

    -- Never destroy the previous valid target because the party or leaderstats
    -- happened to replicate one frame later than the dungeon transition.
    if not next(snapshot) then return nil, false, false, connected, resolved, initialized end
    local snapshotChanged = false
    for key, entry in pairs(snapshot) do
        local old = cloneRoster.entries[key]
        if not old or old.name ~= entry.name or tonumber(old.level) ~= tonumber(entry.level)
            or (tonumber(old.missedMatches) or 0) ~= 0 then
            snapshotChanged = true
            break
        end
    end
    if not snapshotChanged then
        for key, _ in pairs(cloneRoster.entries) do
            if not snapshot[key] then
                snapshotChanged = true
                break
            end
        end
    end
    if snapshotChanged then
        cloneRoster.entries = snapshot
        cloneRoster.save()
    end
    local censusComplete = connected > 0 and resolved >= connected and initialized >= connected
    return cloneRoster.lowest(), true, censusComplete, connected, resolved, initialized
end


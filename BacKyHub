            text = updated
            if count == 0 then return text end
        end
    end

    local function refreshStage()
        local stage = STAGES[currentStage] or STAGES[1]
        stageNumber.Text = string.format("%02d", currentStage)
        stageName.Text = stage.map
        stageTarget.Text = string.format("%s  /  TARGET LV.%d", stage.diff:upper(), stage.targetLvl)
        if isHost then
            currentLevelLabel.Text = targetState.ready
                and string.format("LOWEST CLONE LV.%d", targetState.cloneLevel)
                or "WAITING CLONE LV"
        else
            currentLevelLabel.Text = string.format("CURRENT LV.%d", getLocalLevel())
        end
        if collapsedStageLabel then
            collapsedStageLabel.Text = string.format("STAGE %02d  •  LV.%d", currentStage, stage.targetLvl)
        end
        if stagePrevControl then
            stagePrevControl.Active = currentStage > 1
            stagePrevControl.ImageTransparency = currentStage > 1 and 0.05 or 0.72
        end
        if stageNextControl then
            stageNextControl.Active = currentStage < #STAGES
            stageNextControl.ImageTransparency = currentStage < #STAGES and 0.05 or 0.72
        end
    end


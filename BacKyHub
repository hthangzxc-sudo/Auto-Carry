-- Read the getgenv configuration once, before this script starts its runtime.
-- Both camelCase and PascalCase keys are supported for convenience.
local function configValue(...)
    for index = 1, select("#", ...) do
        local key = select(index, ...)
        local value = externalConfig[key]
        if value ~= nil then return value end
    end
    return nil
end

local function configBoolean(defaultValue, ...)
    local value = configValue(...)
    if type(value) == "boolean" then return value end
    if type(value) == "number" then return value ~= 0 end
    if type(value) == "string" then
        local normalized = string.lower(value:match("^%s*(.-)%s*$"))
        if normalized == "true" or normalized == "on" or normalized == "yes" or normalized == "1" then return true end
        if normalized == "false" or normalized == "off" or normalized == "no" or normalized == "0" then return false end
    end
    return defaultValue
end


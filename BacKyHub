            local progress = math.clamp((current - stage.minLvl) / math.max(1, stage.targetLvl - stage.minLvl), 0, 1)
            tween(stageProgressFill, { Size = UDim2.new(progress, 0, 1, 0) }, 0.55)
        end,
        setPlace = function(textValue, color) metricPlace.Text = textValue or ""; if color then metricPlace.TextColor3 = color end end,
        setFlow = function(textValue, color) metricFlow.Text = textValue or ""; if color then metricFlow.TextColor3 = color end end,
        updateGold = function(amount) if goldBalanceBadge then goldBalanceBadge.Text = "GOLD  " .. formatWithCommas(amount) end end,
        updateGamepass = function(passId, owned, currentGold, cost, nextTarget, buying)
            local card = passCards[passId]
            if not card then return end
            local state = buying and "buying" or owned and "owned" or nextTarget and "target" or "idle"
            local color = state == "owned" and card.color or state == "buying" and THEME.AMBER or state == "target" and THEME.ACCENT or THEME.SUBTEXT
            if buying then
                card.badge.Text = card.name .. "  BUYING"
            elseif owned then
                card.badge.Text = card.name .. "  OWNED"
            elseif nextTarget and cost and cost > 0 then
                card.badge.Text = string.format("%s  %d%%", card.name, math.floor(math.clamp(currentGold / cost, 0, 1) * 100))
            else
                card.badge.Text = card.name
            end
            tween(card.badge, { TextColor3 = color }, 0.28)
            tween(card.icon, { ImageColor3 = color, ImageTransparency = state == "idle" and 0.48 or 0 }, 0.28)
            tween(card.miniIcon, { ImageColor3 = color, ImageTransparency = state == "idle" and 0.5 or 0 }, 0.28)
            tween(card.stroke, { Color = color, Transparency = state == "idle" and 0.58 or 0.12 }, 0.28)
            tween(card.miniStroke, { Color = color, Transparency = state == "idle" and 0.62 or 0.08 }, 0.28)
            tween(card.chip, { BackgroundColor3 = state == "idle" and THEME.BG or THEME.CARD_HOVER }, 0.28)
            tween(card.mini, { BackgroundColor3 = state == "idle" and THEME.BG or THEME.CARD }, 0.28)
            if card.state ~= state and state == "owned" then
                card.icon.Rotation, card.miniIcon.Rotation = -18, -18
                tween(card.icon, { Rotation = 0 }, 0.5, Enum.EasingStyle.Back)
                tween(card.miniIcon, { Rotation = 0 }, 0.5, Enum.EasingStyle.Back)
            end
            card.state = state
        end,

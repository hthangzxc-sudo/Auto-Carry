local playerLevelCache = setmetatable({}, { __mode = "k" })

local function readReplicatedPlayerLevel(plr)
    if not plr then return 0 end
    -- Prefer the replicated stat when available.
    local ls = plr:FindFirstChild("leaderstats")
    local lvlObj = ls and ls:FindFirstChild("Level")
    if lvlObj then
        local ok, value = pcall(function() return tonumber(lvlObj.Value) end)
        if ok and value and value > 0 then return value end
    end

    -- In some dungeon sessions leaderstats is not retained on every client,
    -- but remoteGuiHandler copies the exact level into this teammate frame.
    local playerGui = localPlayer:FindFirstChildOfClass("PlayerGui")
    local playerStatus = playerGui and playerGui:FindFirstChild("playerStatus")
    local frame = playerStatus and playerStatus:FindFirstChild("Frame")
    local holder = frame and frame:FindFirstChild("teammateHolder")
    local teammate = holder and (holder:FindFirstChild(plr.Name)
        or holder:FindFirstChild((playerRealNames and playerRealNames[plr]) or ""))
    local levelBorder = teammate and teammate:FindFirstChild("levelBorder")
    local levelLabel = levelBorder and levelBorder:FindFirstChild("level")
    if levelLabel and levelLabel:IsA("TextLabel") then
        local value = tonumber(tostring(levelLabel.Text):match("%d+"))
        if value and value > 0 then return value end
    end

    -- Final live fallback: the clone's replicated overhead level. Restrict the
    -- lookup to objects whose hierarchy explicitly says level/lvl so HP/EXP
    -- numbers can never be mistaken for a level.
    local character = plr.Character
    if character then
        for _, desc in ipairs(character:GetDescendants()) do
            if desc:IsA("TextLabel") then
                local lineage = string.lower(table.concat({
                    tostring(desc.Name),
                    desc.Parent and tostring(desc.Parent.Name) or "",
                    desc.Parent and desc.Parent.Parent and tostring(desc.Parent.Parent.Name) or "",
                }, "/"))
                if string.find(lineage, "level", 1, true) or string.find(lineage, "lvl", 1, true) then
                    local value = tonumber(tostring(desc.Text):match("%d+"))
                    if value and value > 0 then return value end
                end
            end
        end
    end

    return 0
end

local function getPlayerLevel(plr)
    local current = readReplicatedPlayerLevel(plr)
    if current > 0 then
        playerLevelCache[plr] = current
        return current
    end
    return tonumber(playerLevelCache[plr]) or 0
end


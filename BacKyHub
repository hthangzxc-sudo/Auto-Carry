-- Map selection reads the host-maintained roster snapshot only. The snapshot
-- is written at dungeon entry, never seeded from arbitrary lobby/workspace
-- players, so an old clone cannot become a target merely by being nearby.
local function getAuthoritativeCloneTarget()
    if batchDiscovery.active then
        -- A new batch is deliberately learned only from join requests received
        -- after the reset. Never scan arbitrary old workspace players here.
        local discovered = {}
        for key, name in pairs(batchDiscovery.candidates) do
            local plr = getPlayerByNameInsensitive(name)
            local liveLevel = plr and getPlayerLevel(plr) or 0
            if liveLevel > 0 then
                local liveName = (playerRealNames and playerRealNames[plr]) or tostring(plr.Name)
                discovered[key] = { name = liveName, level = liveLevel, missedMatches = 0 }
            end
        end
        if next(discovered) then
            -- Fast-new-batch exception: the host may already be inside the
            -- LV.1 dungeon when clones arrive, so capture those explicitly
            -- accepted joiners immediately rather than waiting for the next
            -- dungeon transition.
            cloneRoster.entries = discovered
            cloneRoster.save()
            batchDiscovery.active = false
            batchDiscovery.startWithoutLobbyClones = false
            batchDiscovery.candidates = {}
            local lowest = cloneRoster.lowest()
            if UI then UI.addLog("New clone batch captured after host start", "success") end
            return lowest and lowest.level, lowest and lowest.name, lowest ~= nil
        end
        return nil, nil, false
    end

    local saved = cloneRoster.lowest()
    if saved and (tonumber(saved.level) or 0) > 0 then
        return saved.level, saved.name, false
    end
    return nil, nil, false
end


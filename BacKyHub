function cloneMemoryState.save()
    pcall(function()
        if not writefile then return end
        local list = {}
        for _, v in pairs(cloneMemoryState.remembered) do table.insert(list, v) end
        table.sort(list, function(a, b) return tostring(a.name) < tostring(b.name) end)
        writefile(cloneMemoryState.lastFile, HttpService:JSONEncode({ clones = list, stage = currentStage }))
    end)
end

function cloneMemoryState.lowest()
    local list = {}
    for _, v in pairs(cloneMemoryState.remembered) do table.insert(list, v) end
    table.sort(list, function(a, b) return (tonumber(a.level) or 0) < (tonumber(b.level) or 0) end)
    return list[1], #list
end

-- Human-readable persistent roster. Each data row is:
-- RobloxName<TAB>LastLevel<TAB>MissedMatches
local cloneRoster = {
    file = "AutoCarry_CloneRoster.txt",
    entries = {},
}

function cloneRoster.load()
    cloneRoster.entries = {}
    pcall(function()
        if not (isfile and readfile and isfile(cloneRoster.file)) then return end
        for line in string.gmatch(readfile(cloneRoster.file), "[^\r\n]+") do
            local name, level, missed = line:match("^([^\t]+)\t(%d+)\t(%d+)$")
            if name and name ~= "" then
                cloneRoster.entries[string.lower(name)] = {
                    name = name,
                    level = math.max(0, tonumber(level) or 0),
                    missedMatches = math.max(0, tonumber(missed) or 0),
                }
            end
        end
    end)
end

function cloneRoster.save()
    pcall(function()
        if not writefile then return end
        local list = {}
        for _, entry in pairs(cloneRoster.entries) do table.insert(list, entry) end
        table.sort(list, function(a, b)
            local aLevel, bLevel = tonumber(a.level) or 0, tonumber(b.level) or 0
            if aLevel ~= bLevel then return aLevel < bLevel end
            return string.lower(a.name) < string.lower(b.name)
        end)
        local lines = {
            "# AutoCarry Clone Roster",
            "# Name\tLast Level\tMissed Matches",
        }
        for _, entry in ipairs(list) do
            table.insert(lines, string.format("%s\t%d\t%d", entry.name, tonumber(entry.level) or 0, tonumber(entry.missedMatches) or 0))
        end
        writefile(cloneRoster.file, table.concat(lines, "\n") .. "\n")
    end)
end

function cloneRoster.lowest()
    local list = {}
    for _, entry in pairs(cloneRoster.entries) do table.insert(list, entry) end
    table.sort(list, function(a, b)
        local aLevel, bLevel = tonumber(a.level) or 0, tonumber(b.level) or 0
        if aLevel ~= bLevel then return aLevel < bLevel end
        return string.lower(a.name) < string.lower(b.name)
    end)
    return list[1], #list
end

function cloneRoster.remove(name)
    local key = string.lower(tostring(name or ""))
    if cloneRoster.entries[key] then
        cloneRoster.entries[key] = nil
        cloneRoster.save()
        return true
    end
    return false
end

-- `participants` is keyed by lower-case Roblox name with `{ name, level }`.
-- Missing roster entries age by one completed dungeon; three absences remove
-- them. A clone that completes the dungeon is reset to zero missed matches.
function cloneRoster.recordCompletedMatch(participants)
    local removed = {}
    for key, entry in pairs(cloneRoster.entries) do
        local participant = participants[key]
        if participant then
            entry.name = participant.name
            entry.level = participant.level
            entry.missedMatches = 0
        else
            entry.missedMatches = (tonumber(entry.missedMatches) or 0) + 1
            if entry.missedMatches >= CONFIG.ROSTER_MAX_MISSED_MATCHES then
                table.insert(removed, entry.name)
                cloneRoster.entries[key] = nil
            end
        end
    end
    for key, participant in pairs(participants) do
        if not cloneRoster.entries[key] then
            cloneRoster.entries[key] = {
                name = participant.name,
                level = participant.level,
                missedMatches = 0,
            }
        end
    end
    cloneRoster.save()
    return removed
end


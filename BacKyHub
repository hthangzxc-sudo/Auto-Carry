local function cloneGamepassSummary(name)
    local plr = getPlayerByNameInsensitive(name)
    if not plr then return "⚪ Offline / chưa đồng bộ" end

    local owned, checked = {}, false
    for _, pass in ipairs(WEBHOOK_GAMEPASSES) do
        local value = plr:FindFirstChild(pass.id)
        local attribute = plr:GetAttribute(pass.id)
        if value and value:IsA("ValueBase") then
            checked = true
            if value.Value == true then table.insert(owned, pass.icon .. " " .. pass.label) end
        elseif attribute ~= nil then
            checked = true
            if attribute == true then table.insert(owned, pass.icon .. " " .. pass.label) end
        end
    end
    if #owned > 0 then return table.concat(owned, " • ") end
    return checked and "— Không sở hữu gamepass đã kiểm tra" or "⚪ Chưa có dữ liệu gamepass"
end

local function getWebhookRequest()
    if syn and type(syn.request) == "function" then return syn.request end
    if type(http_request) == "function" then return http_request end
    if type(request) == "function" then return request end
    if http and type(http.request) == "function" then return http.request end
    return nil
end

local function sendDungeonRosterWebhook(stageIndex)
    if not isHost or not DISCORD_WEBHOOK_ENABLED or DISCORD_WEBHOOK_URL == "" then return end

    task.spawn(function()
        local sender = getWebhookRequest()
        if not sender then
            if UI then UI.addLog("Discord webhook unavailable in this executor", "warn") end
            return
        end

        local roster = {}
        for _, entry in pairs(cloneRoster.entries) do table.insert(roster, entry) end
        table.sort(roster, function(a, b)
            local aLevel, bLevel = tonumber(a.level) or 0, tonumber(b.level) or 0
            if aLevel ~= bLevel then return aLevel < bLevel end
            return string.lower(a.name) < string.lower(b.name)
        end)

        local stage = STAGES[stageIndex] or STAGES[currentStage] or STAGES[1]
        local lowest = roster[1]
        local fields = {
            {
                name = "⚔️ DUNGEON",
                value = string.format("**%s** — `%s`\nTarget **LV.%d**\nMode: `%s`", stage.map, stage.diff, stage.targetLvl, HARDCORE_ENABLED and "HARDCORE" or "NORMAL"),
                inline = true,
            },
            {
                name = "🎯 LOWEST ROSTER",
                value = lowest and string.format("**%s**\nLV.%d", discordSafeText(lowest.name), tonumber(lowest.level) or 0) or "No clone captured",
                inline = true,
            },
        }

        local chunk, chunkNumber = "", 1
        local function flushChunk()
            if chunk == "" then return end
            table.insert(fields, {
                name = string.format("👥 CLONE ROSTER %02d", chunkNumber),
                value = chunk,
                inline = false,
            })
            chunk, chunkNumber = "", chunkNumber + 1
        end

        for index, entry in ipairs(roster) do
            local line = string.format("`%02d` **%s**  •  **LV.%d**\n%s", index, discordSafeText(entry.name), tonumber(entry.level) or 0, cloneGamepassSummary(entry.name))
            if #chunk > 0 and #chunk + #line + 1 > 900 then flushChunk() end
            chunk = chunk == "" and line or (chunk .. "\n" .. line)
        end
        flushChunk()
        if #roster == 0 then
            table.insert(fields, { name = "👥 CLONE ROSTER", value = "No clone was captured for this dungeon.", inline = false })
        end

        local timestamp = nil
        pcall(function() timestamp = DateTime.now():ToIsoDate() end)
        local payload = {
            username = "AUTO CARRY • HOST",
            allowed_mentions = { parse = {} },
            embeds = {{
                title = "✦ DUNGEON ROSTER REPORT",
                description = "Host roster report after dungeon completion.",
                color = 1356006,
                fields = fields,
                footer = { text = "AUTO CARRY  •  Host: " .. discordSafeText(realPlayerName) },
                timestamp = timestamp,
            }},
        }

        local ok, response = pcall(sender, {
            Url = DISCORD_WEBHOOK_URL,
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = HttpService:JSONEncode(payload),
        })
        local statusCode = type(response) == "table" and (response.StatusCode or response.Status) or nil
        if ok and (not statusCode or (statusCode >= 200 and statusCode < 300)) then
            if UI then UI.addLog("Discord roster webhook sent", "success") end
        elseif UI then
            UI.addLog("Discord roster webhook failed", "warn")
        end
    end)
end

function cloneMemoryState.runHost()
    cloneMemoryState.load()
    cloneRoster.load()
    -- Host owns this file. Create the readable empty roster on first launch
    -- as well, so clone clients never need to create one.
    cloneRoster.save()

    -- A transition/reload can briefly remove every clone's leaderstats. Seed
    -- the displayed/pending lobby map from the roster in that window so it
    -- remains the same target that was used in the dungeon. A live resolver
    -- below immediately replaces this with the clone's current level.
    local savedTarget = cloneRoster.lowest()
    if savedTarget and (tonumber(savedTarget.level) or 0) > 0 then
        syncStageFromLowestCloneLevel(savedTarget.level, savedTarget.name)
    else
        -- First batch has no roster yet. Open a harmless LV.1 bootstrap lobby,
        -- accept a clone, then create the roster only when the party enters
        -- the first dungeon.
        currentStage = 1
        targetState.ready = true
        targetState.stageIndex = 1
        targetState.cloneLevel = 0
        targetState.cloneName = "Awaiting first roster"
        targetState.lastLiveAt = os.clock()
        batchDiscovery.active = true
        batchDiscovery.bootstrapAwaitingDungeon = true
        batchDiscovery.startWithoutLobbyClones = false
        batchDiscovery.candidates = {}
        saveStage()
    end

    local hostState = {
        isReplaying = false,
        -- This stays fixed for the dungeon already in progress. `currentStage`
        -- may advance while a clone levels up, and then represents the next lobby.
        activeStageIndex = currentStage,
        lastJoinActivityAt = os.clock(),
        lastLobbyCreateAt = -math.huge,
        lobbyCreatedSuccessfully = false,
        -- The room's map is captured here. `currentStage` can change after a
        -- clone joins, but that change must apply to the following lobby.
        lobbyStageIndex = currentStage,
        lobbyStartRequested = false,
        needsLobbyRebuild = false,
        autoStartedDone = false,
        requiredCloneWaitStartedAt = nil,
        rosterRequiredWaitStartedAt = nil,
        rosterFinishRecorded = false,
        webhookSentForMatch = false,
        -- Remains true until a non-empty, level-resolved dungeon snapshot is
        -- committed. It is intentionally independent of the old roster state.
        rosterSnapshotPending = isInDungeon(),
        rosterRefreshUntil = isInDungeon() and (os.clock() + 15) or -math.huge,
        lastRosterDetectionSignature = nil,
        censusConnected = 0,
        censusLevels = 0,
        censusCharacters = 0,
        acceptedRequestIds = {},
        pendingJoinRequests = {},
    }

    onCloneDataCleared = function()
        hostState.lobbyStartRequested = false
        hostState.lobbyCreatedSuccessfully = false
        hostState.lobbyStageIndex = nil
        hostState.needsLobbyRebuild = false
        hostState.lastLobbyCreateAt = os.clock()
        hostState.rosterRequiredWaitStartedAt = nil
        hostState.rosterSnapshotPending = isInDungeon()
        hostState.rosterRefreshUntil = isInDungeon() and (os.clock() + 15) or -math.huge
        hostState.lastRosterDetectionSignature = nil
        hostState.censusConnected = 0
        hostState.censusLevels = 0
        hostState.censusCharacters = 0

        -- If an old high-level room is still open, close it now. The normal
        -- lobby loop will rebuild Desert Temple Easy from `currentStage = 1`.
        if isInLobby() then
            local closed = fireRemote("leaveGame")
            if not closed then fireRemote("ReturnToLobbyEvent") end
        end
    end

    local function getRequiredRosterClone()
        local record = cloneRoster.lowest()
        if not record then return nil, nil, false end
        local plr = getPlayerByNameInsensitive(record.name)
        local replicatedLevel = plr and getPlayerLevel(plr) or 0
        local char = plr and plr.Character
        local isReady = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChildOfClass("Humanoid"))
            and replicatedLevel > 0
        return record, plr, isReady == true
    end

    local function recordRosterCompletion()
        if hostState.rosterFinishRecorded then return end
        hostState.rosterFinishRecorded = true
        -- Membership is frozen from dungeon entry; only refresh Levels for
        -- those same recorded clones after the run, then persist the host
        -- roster before calculating the next lobby target.
        local changed = false
        for _, entry in pairs(cloneRoster.entries) do
            local plr = getPlayerByNameInsensitive(entry.name)
            local liveLevel = plr and getPlayerLevel(plr) or 0
            if liveLevel > 0 and entry.level ~= liveLevel then
                entry.level = liveLevel
                changed = true
            end
        end
        if changed then cloneRoster.save() end
    end

    local function sendCompletionWebhookOnce()
        if hostState.webhookSentForMatch then return end
        hostState.webhookSentForMatch = true
        sendDungeonRosterWebhook(hostState.activeStageIndex)
    end

    local lastLobbyRetargetAt = -math.huge
    local function abandonMismatchedLobby()
        if not hostState.lobbyCreatedSuccessfully or not targetState.ready then return end
        if hostState.lobbyStageIndex == targetState.stageIndex then return end
        if os.clock() - lastLobbyRetargetAt < 2 then return end

        lastLobbyRetargetAt = os.clock()
        hostState.lobbyCreatedSuccessfully = false
        hostState.lobbyStartRequested = false
        hostState.lobbyStageIndex = nil
        hostState.lastLobbyCreateAt = os.clock()

        -- The supplied game source uses `leaveGame` to close an open lobby.
        -- Retain the older remote as a compatibility fallback.
        local closed = fireRemote("leaveGame")
        if not closed then fireRemote("ReturnToLobbyEvent") end
        UI.addLog("Lobby target changed; rebuilding for the lowest clone", "warn")
    end

    -- The roster keeps the target stable during transitions. It is only
    -- replaced by `snapshotHostDungeonRoster` at the next dungeon entry.
    task.spawn(function()
        while runtimeActive() and task.wait(CONFIG.TARGET_SYNC_INTERVAL) do
            -- Reconcile against the exact participant source used by the
            -- dungeon ready UI. An incomplete census remains pending.
            if isInDungeon() and (hostState.rosterSnapshotPending or os.clock() < hostState.rosterRefreshUntil) then
                local capturedLowest, captured, censusComplete, connected, resolved, initialized = snapshotHostDungeonRoster()
                hostState.censusConnected = connected or 0
                hostState.censusLevels = resolved or 0
                hostState.censusCharacters = initialized or 0
                if captured and capturedLowest then
                    hostState.rosterSnapshotPending = not censusComplete
                    batchDiscovery.active = false
                    batchDiscovery.bootstrapAwaitingDungeon = false
                    batchDiscovery.startWithoutLobbyClones = false
                    local changed = syncStageFromLowestCloneLevel(capturedLowest.level, capturedLowest.name)
                    local signature = string.lower(capturedLowest.name) .. ":" .. tostring(capturedLowest.level)
                    if changed or signature ~= hostState.lastRosterDetectionSignature then
                        hostState.lastRosterDetectionSignature = signature
                        UI.addLog(string.format("Clone detected in dungeon: %s LV.%d", capturedLowest.name, capturedLowest.level), "success")
                    end
                end
            end
            local targetLevel, targetName, targetIsLive = getAuthoritativeCloneTarget()
            if targetLevel then
                if targetIsLive then
                    cloneMemoryState.remembered[string.lower(targetName)] = { name = targetName, level = targetLevel }
                end
                local changed = syncStageFromLowestCloneLevel(targetLevel, targetName)
                if changed and isInLobby() then
                    abandonMismatchedLobby()
                end
            else
                if not batchDiscovery.active and not batchDiscovery.bootstrapAwaitingDungeon
                    and (not targetState.ready or os.clock() - targetState.lastLiveAt >= CONFIG.CLONE_TARGET_GRACE) then
                    clearCloneTarget()
                end
            end
        end
    end)

    canHostStartMatch = function()
        -- Lobby has one job: build the selected room and start it. Clone
        -- discovery/readiness is handled after entry, inside the dungeon.
        if hostState.lobbyCreatedSuccessfully and hostState.lobbyStageIndex ~= targetState.stageIndex then
            return false, "retargeting lobby for lowest clone"
        end
        return true
    end

    local function buttonCaption(button)
        if button:IsA("TextButton") then return string.lower(tostring(button.Text)) end
        for _, desc in ipairs(button:GetDescendants()) do
            if desc:IsA("TextLabel") and desc.Text ~= "" then
                return string.lower(tostring(desc.Text))
            end
        end
        return ""
    end

    local function isJoinRequestAcceptButton(button)
        if not (button:IsA("TextButton") or button:IsA("ImageButton")) or not button.Visible then return false end
        local caption = buttonCaption(button):match("^%s*(.-)%s*$")
        if caption ~= "accept" then return false end

        -- Require the request dialog context so unrelated Accept/Confirm buttons
        -- elsewhere in the game's UI are never pressed.
        local node = button.Parent
        while node and not node:IsA("PlayerGui") do
            for _, desc in ipairs(node:GetDescendants()) do
                if desc:IsA("TextLabel") and string.find(string.lower(tostring(desc.Text)), "join request", 1, true) then
                    return true
                end
            end
            node = node.Parent
        end
        return false
    end

    local function pressJoinAcceptButton(button)
        -- Activate reaches modern GUI handlers; firesignal covers older handlers
        -- wired specifically to MouseButton1Click.
        pcall(function() button:Activate() end)
        pcall(function()
            if firesignal then firesignal(button.MouseButton1Click) end
        end)
    end

    local function findAcceptButton(gui)
        if not gui then return nil end
        for _, desc in ipairs(gui:GetDescendants()) do
            if isJoinRequestAcceptButton(desc) then return desc end
        end
        return nil
    end

    local function queueJoinRequest(id, cloneName)
        local reqId = tostring(id or "")
        if reqId == "" or hostState.acceptedRequestIds[reqId] then return end
        local request = hostState.pendingJoinRequests[reqId]
        if request then
            request.cloneName = cloneName or request.cloneName
            return
        end
        hostState.pendingJoinRequests[reqId] = {
            id = id,
            cloneName = cloneName,
            firstSeenAt = os.clock(),
            nextAttemptAt = -math.huge,
            attempts = 0,
            logged = false,
        }
    end

    local function retryJoinAccept(request)
        local now = os.clock()
        if now < request.nextAttemptAt then return end
        request.nextAttemptAt = now + CONFIG.JOIN_ACCEPT_RETRY_INTERVAL
        request.attempts = request.attempts + 1

        -- The request panel can arrive after the remote event. When it is visible,
        -- activate its Accept button too; the remote call remains the fallback.
        local pg = localPlayer:FindFirstChildOfClass("PlayerGui")
        local gui = pg and pg:FindFirstChild("joinRequestConfirm_" .. tostring(request.id))
        local button = findAcceptButton(gui)
        if button then pressJoinAcceptButton(button) end

        if fireRemote("respondJoinRequest", request.id, true) then
            hostState.lastJoinActivityAt = now
            hostState.lobbyStartRequested = false
            hostState.autoStartedDone = false
            if not request.logged then
                request.logged = true
                UI.addLog("Accepting join request: " .. tostring(request.cloneName or request.id), "success")
            end
        end
    end

    local showJoinRequest = getRemote("showJoinRequest", "RemoteEvent")
    if showJoinRequest then
        showJoinRequest.OnClientEvent:Connect(function(id, cloneName, act)
            if not runtimeActive() then return end
            local reqId = tostring(id or "")
            if reqId == "" then return end
            if act == "close" then
                hostState.pendingJoinRequests[reqId] = nil
                return
            end
            if batchDiscovery.active and cloneName and tostring(cloneName) ~= "" then
                batchDiscovery.candidates[string.lower(tostring(cloneName))] = tostring(cloneName)
            end
            if autoToggle then
                queueJoinRequest(id, cloneName)
            end
        end)
    end

    task.spawn(function()
        local lastRequestPanelScanAt = -math.huge
        while runtimeActive() and task.wait(0.1) do
            if not autoToggle then continue end
            local now = os.clock()

            -- Recover requests that were already on screen when this script was
            -- enabled, or whose event handler ran before the panel was created.
            if now - lastRequestPanelScanAt >= 0.35 then
                lastRequestPanelScanAt = now
                local pg = localPlayer:FindFirstChildOfClass("PlayerGui")
                if pg then
                    for _, desc in ipairs(pg:GetDescendants()) do
                        -- This direct UI route handles a request that existed
                        -- before the auto-carry script was executed, so no remote
                        -- event/id was available for the retry queue.
                        if isJoinRequestAcceptButton(desc) then
                            pressJoinAcceptButton(desc)
                        end
                        local reqId = tostring(desc.Name):match("^joinRequestConfirm_(.+)$")
                        if reqId and desc:IsA("GuiObject") and desc.Visible then
                            queueJoinRequest(reqId, nil)
                        end
                    end
                end
            end

            for reqId, request in pairs(hostState.pendingJoinRequests) do
                local clone = getPlayerByNameInsensitive(request.cloneName)
                if request.attempts > 0 and clone then
                    hostState.pendingJoinRequests[reqId] = nil
                    hostState.acceptedRequestIds[reqId] = true
                elseif now - request.firstSeenAt >= CONFIG.JOIN_ACCEPT_TIMEOUT then
                    hostState.pendingJoinRequests[reqId] = nil
                    UI.addLog("Join request timed out: " .. tostring(request.cloneName or reqId), "warn")
                else
                    retryJoinAccept(request)
                end
            end
        end
    end)

    task.spawn(function()
        while runtimeActive() and task.wait(0.1) do
            if not autoToggle then continue end
            local started = observeMatchState()
            if not started then
                hostState.requiredCloneWaitStartedAt = nil
                if hostState.lobbyCreatedSuccessfully then
                    local elapsed = os.clock() - hostState.lastJoinActivityAt
                    local remaining = math.max(0, CONFIG.START_DELAY - elapsed)
                    local lobbyStage = STAGES[hostState.lobbyStageIndex] or STAGES[currentStage]
                    local targetStage = STAGES[currentStage]
                    local detail = hostState.lobbyStageIndex == currentStage
                        and string.format("Lobby: %s (%s)", lobbyStage.map, lobbyStage.diff)
                        or string.format("Lobby: %s (%s) | Locked next: %s (%s)", lobbyStage.map, lobbyStage.diff, targetStage.map, targetStage.diff)
                    -- This is a single immediate preflight, never a wait.
                    -- If a clone already joined this exact host lobby, set its
                    -- target before starting; otherwise enter stage 1 at once.
                    if not next(cloneRoster.entries) then
                        local lobbyLevel, lobbyName = getLowestHostLobbyCloneLevel()
                        if lobbyLevel and lobbyName then
                            local changed = syncStageFromLowestCloneLevel(lobbyLevel, lobbyName)
                            if changed and hostState.lobbyStageIndex ~= targetState.stageIndex then
                                abandonMismatchedLobby()
                                continue
                            end
                        end
                    end
                    hostState.rosterRequiredWaitStartedAt = nil
                    UI.setStatus("LOBBY READY", detail, "normal")
                    UI.setCountdown("Entering now", true)
                    if not hostState.lobbyStartRequested then
                        hostState.lobbyStartRequested = startMatch()
                    end
                else
                    UI.setStatus("LOBBY", "Preparing a new room", "normal")
                    UI.setCountdown("", false)
                end
            else
                if isDungeonBusy() then
                    hostState.autoStartedDone = true
                    UI.setCountdown("", false)
                    if hostState.rosterSnapshotPending then
                        UI.setStatus("WAITING FOR CLONE IN DUNGEON", "Host entered stage 1; detecting clone party", "warning")
                        continue
                    end
                    local activeStage = STAGES[hostState.activeStageIndex] or STAGES[currentStage]
                    local targetStage = STAGES[targetState.stageIndex or currentStage]
                    local detail = hostState.activeStageIndex == (targetState.stageIndex or currentStage)
                        and string.format("%s (%s) | Target LV.%d", activeStage.map, activeStage.diff, activeStage.targetLvl)
                        or string.format("Running: %s (%s) | Clone target: %s (%s), LV.%d", activeStage.map, activeStage.diff, targetStage.map, targetStage.diff, targetStage.targetLvl)
                    UI.setStatus("DUNGEON ACTIVE", detail, "active")
                elseif not hostState.autoStartedDone then
                    if hostState.rosterSnapshotPending then
                        UI.setStatus("SCANNING CLONES", string.format("Levels %d/%d | Characters %d/%d",
                            hostState.censusLevels, hostState.censusConnected,
                            hostState.censusCharacters, hostState.censusConnected), "warning")
                        UI.setCountdown("Resolving dungeon players...", true)
                        continue
                    end
                    local readyCount = getReadyDungeonCloneCounts()
                    local lowestLevel, lowestName = getLowestConnectedCloneLevel()
                    local record = lowestLevel and lowestName and { name = lowestName, level = lowestLevel } or nil

                    if record then
                        local plr = getPlayerByNameInsensitive(record.name)
                        local char = plr and plr.Character
                        local isReady = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChildOfClass("Humanoid"))
                            and getPlayerLevel(plr) > 0

                        if isReady then
                            hostState.requiredCloneWaitStartedAt = nil
                            local elapsed = os.clock() - hostState.lastJoinActivityAt
                            local remaining = math.max(0, CONFIG.START_DELAY - elapsed)
                            UI.setStatus("CLONE READY", string.format("Synchronizing with %s", record.name), "normal")
                            UI.setCountdown(string.format("Start in %.1fs", remaining), true)
                            if elapsed >= CONFIG.START_DELAY then
                                hostState.autoStartedDone = startMatch()
                            end
                        else
                            hostState.requiredCloneWaitStartedAt = hostState.requiredCloneWaitStartedAt or os.clock()
                            local waitTime = os.clock() - hostState.requiredCloneWaitStartedAt
                            local remain = math.max(0, CONFIG.REQUIRED_CLONE_TIMEOUT - waitTime)
                            UI.setStatus("WAITING FOR CLONE", string.format("%s (LV.%s)", record.name, tostring(record.level)), "warning")
                            UI.setCountdown(string.format("Timeout %ds", math.floor(remain)), true)

                            if waitTime >= CONFIG.REQUIRED_CLONE_TIMEOUT then
                                UI.addLog(string.format("Clone %s timed out and was removed from memory", record.name), "warn")
                                cloneMemoryState.remembered[string.lower(record.name)] = nil
                                cloneMemoryState.save()
                                hostState.requiredCloneWaitStartedAt = nil
                            end
                        end
                    elseif readyCount > 0 then
                        local elapsed = os.clock() - hostState.lastJoinActivityAt
                        local remaining = math.max(0, CONFIG.START_DELAY - elapsed)
                        UI.setStatus("CLONES READY", string.format("%d clones in dungeon", readyCount), "normal")
                        UI.setCountdown(string.format("Start in %.1fs", remaining), true)
                        if elapsed >= CONFIG.START_DELAY then
                            hostState.autoStartedDone = startMatch()
                        end
                    else
                        UI.setStatus("SCANNING CLONES", "Waiting for player and level replication", "warning")
                        UI.setCountdown("Detecting dungeon party...", true)
                    end
                end
            end
        end
    end)

    task.spawn(function()
        local lastState = isMatchStarted()
        local activeStageIndex = currentStage
        local bossDetectedAt = nil

        while runtimeActive() and task.wait(1) do
            if not autoToggle then continue end
            local started = observeMatchState()

            if started and not lastState then
                hostState.isReplaying = false
                hostState.pendingJoinRequests = {}
                hostState.rosterFinishRecorded = false
                hostState.webhookSentForMatch = false
                activeStageIndex = hostState.lobbyStageIndex or currentStage
                hostState.activeStageIndex = activeStageIndex
                targetState.activeStageIndex = activeStageIndex
                bossDetectedAt = nil
                hostState.rosterSnapshotPending = true
                hostState.rosterRefreshUntil = os.clock() + 15
                local snapshotLowest, hasSnapshot, censusComplete, connected, resolved, initialized = snapshotHostDungeonRoster()
                hostState.censusConnected = connected or 0
                hostState.censusLevels = resolved or 0
                hostState.censusCharacters = initialized or 0
                batchDiscovery.bootstrapAwaitingDungeon = false
                if hasSnapshot and snapshotLowest then
                    hostState.rosterSnapshotPending = not censusComplete
                    syncStageFromLowestCloneLevel(snapshotLowest.level, snapshotLowest.name)
                    UI.addLog(string.format("Host roster captured: %s LV.%d is the target", snapshotLowest.name, snapshotLowest.level), "success")
                else
                    UI.addLog("Dungeon started without a clone roster snapshot", "warn")
                end
                UI.addLog(string.format("Dungeon started: %s (%s) | Target LV.%d",
                    STAGES[activeStageIndex].map, STAGES[activeStageIndex].diff, STAGES[activeStageIndex].targetLvl), "info")
            elseif not started and lastState then
                hostState.acceptedRequestIds = {}
                hostState.lobbyCreatedSuccessfully = false
                hostState.lobbyStageIndex = nil
                hostState.autoStartedDone = false
                targetState.activeStageIndex = nil
                applyTargetToLobby()
                -- Returning from a dungeon can leave the old room allocated on
                -- the server. Close it once before attempting createLobby for a
                -- different clone-derived stage.
                hostState.needsLobbyRebuild = targetState.ready and targetState.stageIndex ~= activeStageIndex
                if hostState.needsLobbyRebuild then
                    hostState.lastLobbyCreateAt = os.clock()
                end
                bossDetectedAt = nil
                UI.addLog("Returned to lobby; preparing a new room", "info")
            end
            lastState = started

            if started then
                local busyNow = isDungeonBusy()
                local minCloneLvl, minCloneName, cloneCount = getLowestConnectedCloneLevel()
                minCloneLvl = minCloneLvl or 999

                for _, plr in ipairs(Players:GetPlayers()) do
                    if plr ~= localPlayer then
                        local lvl = getPlayerLevel(plr)
                        local rName = (playerRealNames and playerRealNames[plr]) or tostring(plr.Name)
                        if lvl > 0 then
                            cloneMemoryState.remembered[string.lower(rName)] = { name = rName, level = lvl }
                        end
                    end
                end

                -- A new batch can start before any clone reaches the lobby.
                -- As soon as clone members are visible inside the dungeon,
                -- take the host-side party snapshot and let it drive the
                -- following map selection.
                if hostState.rosterSnapshotPending and cloneCount > 0 and minCloneLvl ~= 999 then
                    local joinedLowest, joinedSnapshot, censusComplete, connected, resolved, initialized = snapshotHostDungeonRoster()
                    hostState.censusConnected = connected or 0
                    hostState.censusLevels = resolved or 0
                    hostState.censusCharacters = initialized or 0
                    if joinedSnapshot and joinedLowest then
                        hostState.rosterSnapshotPending = not censusComplete
                        batchDiscovery.active = false
                        batchDiscovery.bootstrapAwaitingDungeon = false
                        batchDiscovery.startWithoutLobbyClones = false
                        syncStageFromLowestCloneLevel(joinedLowest.level, joinedLowest.name)
                        UI.addLog(string.format("Clone roster captured inside dungeon: %s LV.%d", joinedLowest.name, joinedLowest.level), "success")
                    end
                end

                local activeStageData = STAGES[activeStageIndex] or STAGES[currentStage]
                local completionTarget = activeStageData.targetLvl
                if busyNow then cloneMemoryState.save() end

                -- The next stage is derived from one stable authoritative
                -- source: the lowest roster clone (with its live Level when
                -- available). `activeStageIndex` stays unchanged, so the map
                -- currently being played is never switched mid-dungeon.
                local nextTargetLevel, nextTargetName = getAuthoritativeCloneTarget()
                if nextTargetLevel then
                    syncStageFromLowestCloneLevel(nextTargetLevel, nextTargetName)
                    UI.setStage(currentStage, nextTargetLevel)
                end

                if getDungeonProgress() == "bosskilled" then
                    bossDetectedAt = bossDetectedAt or os.clock()
                else
                    bossDetectedAt = nil
                    if getDungeonProgress() == "in process" then
                        hostState.rosterFinishRecorded = false
                        -- Replay can start another round without flipping the
                        -- broader in-dungeon state, so arm one report per run.
                        hostState.webhookSentForMatch = false
                    end
                end

                if isDungeonFinished() then
                    local levelPending = cloneCount > 0 and minCloneLvl == 999
                    if levelPending and os.clock() - (bossDetectedAt or os.clock()) < CONFIG.LEVEL_RESOLVE_GRACE then
                        matchCycle.finishConsumed = false
                        UI.setStatus("SYNCING CLONE LEVELS", "Waiting for replicated level data", "warning")
                    elseif cloneCount > 0 and minCloneLvl ~= 999 and targetState.ready and targetState.stageIndex ~= activeStageIndex then
                        recordRosterCompletion()
                        sendCompletionWebhookOnce()
                        local resolvedLevel, resolvedName = getAuthoritativeCloneTarget()
                        if resolvedLevel then syncStageFromLowestCloneLevel(resolvedLevel, resolvedName) end
                        local nextStage = STAGES[targetState.stageIndex]
                        UI.addLog(string.format("Boss defeated; roster target %s LV.%d locked next map to %s (%s)", targetState.cloneName or "clone", targetState.cloneLevel or 0, nextStage.map, nextStage.diff), "success")
                        cloneMemoryState.save()
                        leaveGame("Lowest clone target changed")
                    elseif cloneCount > 0 and minCloneLvl ~= 999 and minCloneLvl >= completionTarget then
                        recordRosterCompletion()
                        sendCompletionWebhookOnce()
                        UI.addLog(string.format("Boss defeated; clone level %d reached target %d", minCloneLvl, completionTarget), "success")
                        local resolvedLevel, resolvedName = getAuthoritativeCloneTarget()
                        if resolvedLevel then syncStageFromLowestCloneLevel(resolvedLevel, resolvedName) end
                        cloneMemoryState.save()
                        leaveGame("Stage target reached")
                    elseif not hostState.isReplaying then
                        recordRosterCompletion()
                        sendCompletionWebhookOnce()
                        hostState.isReplaying = true
                        local reportedLevel = minCloneLvl == 999 and 0 or minCloneLvl
                        UI.addLog(string.format("Level below target (%d/%d); replaying", reportedLevel, completionTarget), "info")
                        local ok = fireRemote("replayDungeon", {{
                            dungeonProgress = "bossKilled", dungeonStarted = true, dungeonFinished = true,
                            hardcore = HARDCORE_ENABLED, dungeonName = activeStageData.map, isHardcore = HARDCORE_ENABLED, fightingBoss = true
                        }})
                        if not ok then
                            matchCycle.finishConsumed = false
                            UI.addLog("Replay request failed; retrying", "warn")
                        end
                        task.wait(CONFIG.REPLAY_COOLDOWN)
                        hostState.isReplaying = false
                    end
                end
            else
                if isInLobby() and not hostState.lobbyCreatedSuccessfully then
                    if hostState.needsLobbyRebuild then
                        hostState.needsLobbyRebuild = false
                        hostState.lastLobbyCreateAt = os.clock()
                        local closed = fireRemote("leaveGame")
                        if not closed then fireRemote("ReturnToLobbyEvent") end
                        UI.addLog("Closing completed room before creating clone target", "info")
                    elseif not targetState.ready then
                        -- No roster is never a reason to stall the lobby.
                        -- Bootstrap a LV.1 room and let clone handling happen
                        -- only after the host has entered the dungeon.
                        currentStage = 1
                        targetState.ready = true
                        targetState.stageIndex = 1
                        targetState.cloneLevel = 0
                        targetState.cloneName = "Dungeon discovery"
                        targetState.lastLiveAt = os.clock()
                        saveStage()
                        UI.setStage(1, 0)
                        UI.addLog("No roster target; bootstrapping Desert Temple Easy", "info")
                    elseif os.clock() - hostState.lastLobbyCreateAt >= CONFIG.LOBBY_RETRY_DELAY then
                        local s = STAGES[targetState.stageIndex]
                        hostState.lastLobbyCreateAt = os.clock()
                        local ok = createStageLobby(s.map, s.diff)
                        if ok then
                            hostState.lobbyCreatedSuccessfully = true
                            hostState.lobbyStageIndex = targetState.stageIndex
                            hostState.lobbyStartRequested = false
                            hostState.lastJoinActivityAt = os.clock()
                            UI.addLog("Lobby created from clone target: " .. s.map .. " (" .. s.diff .. ")", "success")
                        end
                    end
                end
            end
        end
    end)

    -- Wake on the stable signals that actually exist in live dungeon sessions:
    -- player membership, character replication, and optional leaderstats.
    local hookedPlayers = setmetatable({}, { __mode = "k" })
    local hookedLeaderstats = setmetatable({}, { __mode = "k" })
    local function wakeDungeonRosterResolver()
        if runtimeActive() and isInDungeon() then
            hostState.rosterSnapshotPending = true
            hostState.rosterRefreshUntil = os.clock() + 30
        end
    end
    local function hookLeaderstats(leaderstats)
        if not leaderstats or hookedLeaderstats[leaderstats] then return end
        hookedLeaderstats[leaderstats] = true
        local function hookLevel(levelObject)
            if not levelObject or levelObject.Name ~= "Level" then return end
            wakeDungeonRosterResolver()
            levelObject:GetPropertyChangedSignal("Value"):Connect(wakeDungeonRosterResolver)
        end
        hookLevel(leaderstats:FindFirstChild("Level"))
        leaderstats.ChildAdded:Connect(hookLevel)
    end
    local function hookDungeonParticipant(plr)
        if not runtimeActive() or plr == localPlayer or hookedPlayers[plr] then return end
        hookedPlayers[plr] = true
        wakeDungeonRosterResolver()
        hookLeaderstats(plr:FindFirstChild("leaderstats"))
        plr.ChildAdded:Connect(function(child)
            if child.Name == "leaderstats" then hookLeaderstats(child) end
            if child.Name == "leaderstats" then wakeDungeonRosterResolver() end
        end)
        plr.CharacterAdded:Connect(wakeDungeonRosterResolver)
    end
    for _, plr in ipairs(Players:GetPlayers()) do hookDungeonParticipant(plr) end
    Players.PlayerAdded:Connect(hookDungeonParticipant)
    Players.PlayerRemoving:Connect(function(plr)
        if plr ~= localPlayer then wakeDungeonRosterResolver() end
    end)
end

function cloneMemoryState.runClone()
    local hostMissingSince = nil
    local lastJoinAttempt = -math.huge
    local isBuyingGamepass = false
    local isLeavingForGamepass = false
    local lastPriceFetch = -math.huge
    local lastPriceLevel = -1
    local passCache = {}
    local purchaseRetryAt = {}
    local purchaseFailures = {}

    local GAMEPASS_PRIORITY = {
        { id = "vip",               label = "VIP" },
        { id = "goldGamepass",      label = "X2 Gold" },
        { id = "extraItemGamepass", label = "+1 Item" },
        { id = "freeStatResets",    label = "Free Stat Resets" }
    }

    local function isPassOwned(id)
        local obj = localPlayer:FindFirstChild(id)
        if obj and obj:IsA("ValueBase") and obj.Value == true then
            return true
        end
        if passCache[id] and passCache[id].owned == true then
            return true
        end
        return false
    end

    local function updatePassPrices(force)
        local currentLevel = getLocalLevel()
        if currentLevel > 0 and currentLevel ~= lastPriceLevel then force = true end
        if not force and os.clock() - lastPriceFetch < 15 then return end
        lastPriceFetch = os.clock()
        if currentLevel > 0 then lastPriceLevel = currentLevel end

        for _, item in ipairs(GAMEPASS_PRIORITY) do
            if not runtimeActive() then return end
            local id = item.id
            if isPassOwned(id) then
                local knownCost = passCache[id] and passCache[id].cost or latestGamepassPrices[id] and latestGamepassPrices[id].cost
                passCache[id] = { cost = knownCost, owned = true, ready = true }
                latestGamepassPrices[id] = { cost = knownCost, owned = true, ready = true }
            elseif not passCache[id] or not passCache[id].cost or force then
                local ok, info = invokeRemote("getGoldGamepassPrice", id)
                if ok and type(info) == "table" then
                    passCache[id] = {
                        cost = tonumber(info.cost),
                        owned = (info.owned == true) or isPassOwned(id),
                        ready = info.ready ~= false,
                    }
                    latestGamepassPrices[id] = {
                        cost = passCache[id].cost,
                        owned = passCache[id].owned,
                        ready = passCache[id].ready,
                    }
                end
            end
        end
    end
    refreshGamepassPricesForHistory = function()
        updatePassPrices(true)
        return latestGamepassPrices
    end

    local function getNextPriorityTarget()
        for _, item in ipairs(GAMEPASS_PRIORITY) do
            if not isPassOwned(item.id) then
                local data = passCache[item.id]
                return item, data and data.ready and data.cost or nil
            end
        end
        return nil, nil
    end

    local goldPurchaseResult = getRemote("goldGamepassPurchaseResult", "RemoteEvent")
    if goldPurchaseResult then
        goldPurchaseResult.OnClientEvent:Connect(function(res)
            if not runtimeActive() then return end
            if type(res) == "table" and res.success and res.gamepassKey then
                if passCache[res.gamepassKey] then
                    passCache[res.gamepassKey].owned = true
                    latestGamepassPrices[res.gamepassKey] = {
                        cost = passCache[res.gamepassKey].cost or 0,
                        owned = true,
                        ready = true,
                    }
                end
                purchaseFailures[res.gamepassKey] = 0
                purchaseRetryAt[res.gamepassKey] = os.clock() + 5
            end
        end)
    end

    task.spawn(function()
        while runtimeActive() and task.wait(0.8) do
            if not autoToggle then continue end

            updatePassPrices(false)
            local currentGold = getLocalGold()
            local targetPass, cost = getNextPriorityTarget()

            for _, pItem in ipairs(GAMEPASS_PRIORITY) do
                local owned = isPassOwned(pItem.id)
                local isTarget = targetPass and (targetPass.id == pItem.id)
                local pCost = passCache[pItem.id] and passCache[pItem.id].cost or (isTarget and cost or 0)
                UI.updateGamepass(pItem.id, owned, currentGold, pCost, isTarget, isBuyingGamepass and isTarget)
            end

            local myLvl = getLocalLevel()
            if myLvl > 0 then
                UI.setStage(currentStage, myLvl)
            end

            if isInLobby() then
                isLeavingForGamepass = false

                if targetPass and cost and cost > 0 and currentGold >= cost and os.clock() >= (purchaseRetryAt[targetPass.id] or -math.huge) then
                    isBuyingGamepass = true
                    UI.setStatus("PURCHASING GAMEPASS", string.format("%s for %d Gold", targetPass.label, cost), "warning")
                    UI.addLog(string.format("Purchasing %s | Cost %d | Gold %d", targetPass.label, cost, currentGold), "info")

                    local bought = fireRemote("requestGoldGamepassPurchase", targetPass.id)
                    local confirmed = false
                    if bought then
                        local beforeGold = currentGold
                        local waitStart = os.clock()
                        repeat
                            task.wait(0.3)
                            currentGold = getLocalGold()
                        until currentGold < beforeGold or isPassOwned(targetPass.id) or (os.clock() - waitStart >= 6) or not isInLobby() or not runtimeActive()

                        confirmed = currentGold < beforeGold or isPassOwned(targetPass.id)
                        if confirmed then
                            if passCache[targetPass.id] then
                                passCache[targetPass.id].owned = true
                            end
                            UI.addLog(string.format("Purchased %s; %d Gold remaining", targetPass.label, currentGold), "success")
                        else
                            UI.addLog("Server did not confirm purchase: " .. targetPass.label, "warn")
                        end
                    end
                    if confirmed then
                        purchaseFailures[targetPass.id] = 0
                        purchaseRetryAt[targetPass.id] = os.clock() + 5
                    else
                        local failures = (purchaseFailures[targetPass.id] or 0) + 1
                        purchaseFailures[targetPass.id] = failures
                        purchaseRetryAt[targetPass.id] = os.clock() + math.min(60, 5 * (2 ^ (failures - 1)))
                    end
                    isBuyingGamepass = false
                    task.wait(CONFIG.GOLD_PURCHASE_DELAY or 1.5)
                else
                    isBuyingGamepass = false
                end
            else
                if targetPass and cost and currentGold >= cost then
                    if not isLeavingForGamepass then
                        isLeavingForGamepass = true
                        isBuyingGamepass = true
                        UI.setStatus("GAMEPASS AFFORDABLE", string.format("%d/%d Gold; returning for %s", currentGold, cost, targetPass.label), "warning")
                        UI.addLog(string.format("Returning to buy %s (%d/%d Gold)", targetPass.label, currentGold, cost), "info")
                        task.spawn(function()
                            leaveGame("Purchasing " .. targetPass.label)
                            task.wait(10)
                            isLeavingForGamepass = false
                        end)
                    end
                end
            end
        end
    end)

    local ls = localPlayer:FindFirstChild("leaderstats")
    local lvlObj = ls and ls:FindFirstChild("Level")
    if lvlObj then
        lvlObj:GetPropertyChangedSignal("Value"):Connect(function()
            if not runtimeActive() then return end
            updatePassPrices(true)
        end)
    end

    task.spawn(function()
        while runtimeActive() and task.wait(0.25) do
            if not autoToggle then continue end

            if isMatchStarted() then
                local hostPlr = getPlayerByNameInsensitive(HOST_NAME)
                if not hostPlr then
                    hostMissingSince = hostMissingSince or os.clock()
                    local missingFor = os.clock() - hostMissingSince
                    UI.setStatus("HOST CONNECTION LOST", string.format("Host missing for %.1f/%.1fs", missingFor, CONFIG.LOST_HOST_TIMEOUT), "danger")
                    UI.setCountdown(string.format("Exit in %.1fs", math.max(0, CONFIG.LOST_HOST_TIMEOUT - missingFor)), true)

                    if missingFor >= CONFIG.LOST_HOST_TIMEOUT then
                        UI.addLog("Host left; clone is returning", "warn")
                        leaveGame("Host left")
                        break
                    end
                else
                    hostMissingSince = nil
                    UI.setStatus("FOLLOWING HOST", string.format("Connected to %s", HOST_NAME), "active")
                    UI.setCountdown("", false)
                end
            else
                hostMissingSince = nil
                if isBuyingGamepass then
                    UI.setStatus("PURCHASING GAMEPASS", "Join requests paused", "warning")
                    UI.setCountdown("", false)
                else
                    local elapsed = os.clock() - lastJoinAttempt
                    local remaining = math.max(0, CONFIG.JOIN_REQUEST_INTERVAL - elapsed)
                    UI.setStatus("CONNECTING TO HOST", string.format("Target: %s", HOST_NAME), "normal")
                    UI.setCountdown(string.format("Request in %.1fs", remaining), true)

                    if elapsed >= CONFIG.JOIN_REQUEST_INTERVAL then
                        lastJoinAttempt = os.clock()
                        invokeRemote("sendJoinRequest", HOST_NAME)
                    end
                end
            end
        end
    end)

    Players.PlayerRemoving:Connect(function(plr)
        if not runtimeActive() then return end
        local rName = (playerRealNames and playerRealNames[plr]) or tostring(plr.Name)
        if autoToggle and isMatchStarted() and string.lower(rName) == string.lower(HOST_NAME) then
            UI.addLog("Host disconnect detected", "warn")
            leaveGame("Host disconnected")
        end
    end)
end

task.spawn(function()
    local ok, err = pcall(function()
        if isHost then
            cloneMemoryState.runHost()
        else
            cloneMemoryState.runClone()
        end
    end)
    if not ok then
        reportRemoteProblem("runtime", tostring(err))
        if UI then UI.addLog("Runtime initialization failed: " .. tostring(err), "danger") end
    end
end)

pcall(function()
    UI.addLog("Auto Carry Pro initialized", "success")
    if not isHost then
        UI.addLog("Clone automation ready", "info")
    end
end)
